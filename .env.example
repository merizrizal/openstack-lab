# Local development environment.
#
# Copy this file to `.env` if you want to override the default values.

# Local OpenStack Lab.
# OS_PASSWORD is intentionally blank. Set it only in your private local env.
OS_AUTH_URL=http://192.168.121.5:5000/v3
OS_IDENTITY_API_VERSION=3
OS_INTERFACE=public
OS_REGION_NAME=RegionOne
OS_PROJECT_NAME=admin
OS_USERNAME=admin
OS_PASSWORD=
OS_DOMAIN_NAME=Default
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

CODEX_MODEL=gpt-5.6-luna

# Conversational CLI backend: "codex" (default) or "pi".
AI_CLIENT=codex

# Pi settings apply to openstack-ai and openstack-agent. In agent mode, goals,
# system instructions, OpenStack observations, memory and retrieved knowledge
# are sent to the selected provider. This opt-in is not redaction; never place
# credentials, tokens or private keys in goals or knowledge.
# Leave outbound disabled unless this transfer is approved.
AI_PI_ALLOW_OUTBOUND=false
AI_MODEL_PROVIDER=
AI_MODEL=
PI_CODING_AGENT_DIR=
AI_PI_VERSION=$(pi --version)
PI_BIN=pi
OPENSTACK_AI_DATA_DIR=
OPENSTACK_AI_KNOWLEDGE_DIR=
