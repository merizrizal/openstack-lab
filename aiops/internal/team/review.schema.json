{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "digest": {"type": "string"},
    "verdict": {"type": "string", "enum": ["accept", "revise", "escalate"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {"type": "string"},
          "reason": {"type": "string"}
        },
        "required": ["claim_id", "reason"]
      }
    }
  },
  "required": ["digest", "verdict", "issues"]
}
